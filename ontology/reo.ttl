@prefix reo:     <https://w3id.org/reo/> .
@prefix reot:    <https://w3id.org/reo/type/> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix lrmoo:   <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<https://w3id.org/reo/>
    a owl:Ontology ;
    dcterms:title "Roll Edition Ontology"@en ;
    dcterms:description """A small extension of CIDOC CRM and LRMoo for digital editions of piano rolls. It adds the symbols a reproducing piano reads from a roll (notes and expression commands), the relations between such symbols that an editor states, and the edits by which one version of a roll becomes another. Everything else (physical copies and their holes, recording processes, versions, editorial beliefs) is expressed with CIDOC CRM, LRMoo and CRMinf directly. The closed value lists of the format are the types at https://w3id.org/reo/type/."""@en ;
    dcterms:creator "Niels Pfeffer" ;
    dcterms:created "2026-09-04"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "1.0-draft" ;
    vann:preferredNamespacePrefix "reo" ;
    vann:preferredNamespaceUri "https://w3id.org/reo/" ;
    dcterms:hasPart <https://w3id.org/reo/type/> ;
    rdfs:seeAlso <https://github.com/pfefferniels/linked-rolls> ,
                 <https://pfefferniels.github.io/linked-rolls/> ;
    dcterms:references <http://www.cidoc-crm.org/cidoc-crm/7.1.3/> ,
                       <http://iflastandards.info/ns/lrm/lrmoo/> .


#################################################################
# Classes
#################################################################

reo:Perforation
    a owl:Class ;
    rdfs:subClassOf crm:E90_Symbolic_Object ;
    rdfs:label "Perforation"@en ;
    rdfs:comment """This class comprises the symbols a reproducing piano reads from a roll: the notes it sounds and the commands that govern its mechanism. A perforation is what a hole or a group of holes means once it is read against a tracker bar. The hole itself is an instance of reo:Hole, borne by a copy of the roll (P56 bears feature) and carrying the perforation (P128 carries). One perforation may be carried by holes on several copies of the same roll. A version of the roll, an instance of F2 Expression, is composed of its perforations (P106 is composed of). The measured position of a perforation is that of the holes carrying it; the properties aligned with, before, after and paired with let an editor state where that measurement should give way."""@en ;
    skos:example "the first note of Grünfeld's Träumerei on the Welte-Mignon roll WM 225, recorded in Wien in 1905"@en ,
                 "the sustain pedal command that opens the same roll"@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:Note
    a owl:Class ;
    rdfs:subClassOf reo:Perforation ;
    rdfs:label "Note"@en ;
    rdfs:comment """This class comprises perforations that sound a pitch. The pitch is stated as a MIDI note number (pitch). Its duration follows from the extent of the carrying hole along the roll and is not stated separately."""@en ;
    skos:example "the note c′ (MIDI 60) with which Grünfeld's Träumerei begins on WM 225"@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:Expression
    a owl:Class ;
    rdfs:subClassOf reo:Perforation ;
    rdfs:label "Expression"@en ;
    rdfs:comment """This class comprises perforations that act on the reproducing mechanism rather than sound a note: dynamic commands such as crescendo, forzando and mezzoforte, the pedals, and motor functions such as rewind. The kind of command is given by P2 has type with one of the expression types at https://w3id.org/reo/type/; the half of the keyboard it acts on by scope. The name follows the vocabulary of the reproducing piano, where these are the expression perforations read by the expression box. It is unrelated to F2 Expression in LRMoo, which is the class of the roll's versions."""@en ;
    skos:example "a 'slow crescendo off' on a Welte-Mignon T-100 roll, aligned with the note it belongs to"@en ,
                 "the 'forzando on' and 'forzando off' pair that accents a single chord"@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:RollCopy
    a owl:Class ;
    rdfs:subClassOf lrmoo:F5_Item, crm:E22_Human-Made_Object ;
    rdfs:label "Roll Copy"@en ;
    rdfs:comment """This class comprises the surviving physical copies of a roll. A copy is an instance of F5 Item, being an exemplar in which a version of the roll was published, and an instance of E22 Human-Made Object, being a made thing that bears features: P56 bears feature takes an E19 Physical Object, which F5 Item alone is not. Both statements hold of every copy and no class of CIDOC CRM or LRMoo makes them together, which is why this class is declared."""@en ;
    skos:example "the copy of WM 225 held at Stanford, read from the scan of its paper"@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:Hole
    a owl:Class ;
    rdfs:subClassOf crm:E25_Human-Made_Feature ;
    rdfs:label "Hole"@en ;
    rdfs:comment """This class comprises the perforations punched in the paper of a roll, which is what a reproducing piano reads. A hole is a human-made feature of the paper: the scope note of E25 Human-Made Feature states that it includes "the information encoding features on mechanical or digital carriers". What a hole means once it is read against a tracker bar is a perforation in the sense of reo:Perforation, which the hole carries (P128 carries). The punching pattern is given by reo:pattern."""@en ;
    skos:example "the hole carrying the first note of Grünfeld's Träumerei on the Stanford copy of WM 225"@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:Writing
    a owl:Class ;
    rdfs:subClassOf crm:E25_Human-Made_Feature ;
    rdfs:label "Writing"@en ;
    rdfs:comment """This class comprises the features of a roll that carry text: a printed title, a stamped catalogue number, a date written by hand. What the text says is given by P128 carries, and how the writing was made by reo:method. A writing is a feature of the paper it stands on, which may be the roll itself or a patch glued onto it; the label as a piece of paper is an instance of reo:GluedOn, and the print on it a writing the label bears."""@en ;
    skos:example "the pencilled '225. Fritz. 18. Jan 09.' on the Stanford copy of WM 225"@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:Mark
    a owl:Class ;
    rdfs:subClassOf crm:E25_Human-Made_Feature ;
    rdfs:label "Mark"@en ;
    rdfs:comment """This class comprises the features drawn on a roll that carry no text: a circle around a perforation, a stroke, a cross. What a mark was meant to say is a reading of it, an instance of I16 Meaning Comprehension in CRMinf, and no property of the feature; its shape is therefore not stated as a type. How it was drawn is given by reo:method."""@en ;
    skos:example "a pencil circle around a group of perforations, read as an instruction to punch"@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:GluedOn
    a owl:Class ;
    rdfs:subClassOf crm:E22_Human-Made_Object ;
    rdfs:label "Glued-On"@en ;
    rdfs:comment """This class comprises the pieces of paper and tape glued onto a roll, which cover perforations or reinforce the paper. A patch is an object and not a feature: it was "a separate identifiable whole prior to" the act of gluing, as the scope note of E79 Part Addition requires of what is added, where a hole or a pencil line comes into being in the act that makes it. What it is made of is given by P45 consists of, and it may bear features of its own (P56 bears feature)."""@en ;
    skos:example "the printed label glued to the leader of the Stanford copy of WM 225"@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:Edit
    a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "Edit"@en ;
    rdfs:comment """This class comprises the single changes by which one version of a roll is turned into another: adding symbols, removing them, or both, which amounts to replacing. The creation of the new version, an instance of F28 Expression Creation, consists of its edits (P9 consists of). The kind of change is given by P2 has type, the reason by P17 was motivated by. Uncertainty about an edit, for instance whether a pencil mark on a copy was meant as an instruction to punch, is expressed with CRMinf on the statement, not by a property of this class."""@en ;
    skos:example "the prolongation of a crescendo perforation between versions A and B of WM 225, motivated by 'Verlängerter Bereich ohne Verschiebung'"@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .


#################################################################
# Properties of perforations
#################################################################

reo:alignedWith
    a owl:ObjectProperty ;
    rdfs:domain reo:Perforation ;
    rdfs:range reo:Perforation ;
    rdfs:label "aligned with"@en ;
    rdfs:comment """This property associates a perforation with another perforation whose onset it takes when the roll is performed. It records the editorial statement that the measured offset between the two is not meant: a 'crescendo off' falls on the note it belongs to. The property is not symmetric. The aligned perforation follows, the one it is aligned with keeps its measured place."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:before
    a owl:ObjectProperty ;
    rdfs:domain reo:Perforation ;
    rdfs:range reo:Perforation ;
    rdfs:label "before"@en ;
    rdfs:comment """This property associates a perforation with another perforation whose onset it precedes when the roll is performed, without saying by how much. It records the editorial statement that the order of the two is meant even where the copies disagree on it: a 'crescendo off' ends before the note it leads to begins. The property is not symmetric. A perforation the measurement already has before its reference keeps its place; one it does not is put before the reference as far as the copies that agree with the statement put it."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:after
    a owl:ObjectProperty ;
    rdfs:domain reo:Perforation ;
    rdfs:range reo:Perforation ;
    rdfs:label "after"@en ;
    rdfs:comment """This property associates a perforation with another perforation whose onset it follows when the roll is performed, without saying by how much: the counterpart of before. A perforation is placed by one of aligned with, before and after at most."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:pairedWith
    a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain reo:Perforation ;
    rdfs:range reo:Perforation ;
    rdfs:label "paired with"@en ;
    rdfs:comment """This property associates two perforations whose distance from one another is fixed: whatever displaces the one displaces the other, as a 'forzando on' belongs with its 'forzando off'. Any two perforations may be paired. The property is symmetric and is stated on one side only. A perforation belongs to at most one pair, and the members of a pair are not themselves placed relative to anything, whether aligned with it, before it or after it."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:pitch
    a owl:DatatypeProperty ;
    rdfs:domain reo:Note ;
    rdfs:range xsd:integer ;
    rdfs:label "pitch"@en ;
    rdfs:comment """This property states the pitch of a note as a MIDI note number, 60 for middle C. It is a shortcut of the path P43 has dimension, E54 Dimension typed 'pitch', P90 has value."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:scope
    a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain reo:Expression ;
    rdfs:range crm:E55_Type ;
    rdfs:label "scope"@en ;
    rdfs:comment """This property states which half of the keyboard an expression perforation acts on. On rolls for the Welte-Mignon and most other reproducing systems the expression is split at a fixed point into a bass and a treble half, each with its own set of commands. The values are the types bass and treble at https://w3id.org/reo/type/."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .


#################################################################
# Properties of features
#################################################################

reo:pattern
    a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain reo:Hole ;
    rdfs:range crm:E55_Type ;
    rdfs:label "pattern"@en ;
    rdfs:comment """This property states the punching pattern of a hole: how a long perforation is broken into a chain of holes by bridges of paper, and whether the rows of holes align across the tracks. The values are the types regular, accelerating and staggering at https://w3id.org/reo/type/, following the distinction drawn by Phillips (2016)."""@en ;
    dcterms:bibliographicCitation "Phillips, Peter: Piano Rolls and Contemporary Player Pianos. The Catalogues, Technologies, Archiving and Accessibility. PhD thesis, Sydney Conservatorium of Music, University of Sydney, 2016." ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:method
    a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( reo:Writing reo:Mark ) ] ;
    rdfs:range crm:E55_Type ;
    rdfs:label "method"@en ;
    rdfs:comment """This property states how a feature was made: a writing printed, handwritten or stamped, a mark drawn in ink, pencil or crayon. The values are the types print, handwriting, stamp, ink, pencil and crayon at https://w3id.org/reo/type/. What kind of feature it is, its class says."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .


reo:side
    a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( reo:Writing reo:Mark reo:GluedOn ) ] ;
    rdfs:range crm:E55_Type ;
    rdfs:label "side"@en ;
    rdfs:comment """This property states which face of the paper a feature lies on: the types recto and verso at https://w3id.org/reo/type/. A hole takes no side, going through the paper and lying on both faces at once, which is why the domain names the three kinds that sit on one. Recto is the face that meets the tracker bar as the roll plays."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:rotation
    a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( reo:Writing reo:GluedOn ) ] ;
    rdfs:range crm:E54_Dimension ;
    rdfs:label "rotation"@en ;
    rdfs:comment """This property states how far a writing or a patch stands askew on the paper, clockwise from the line across the roll, as a dimension in degrees (P90 has value, P91 has unit with the type deg). It is a subproperty of P43 has dimension rather than that property itself, so that an angle is told apart from the horizontal and vertical extents, which are dimensions of the same feature. A mark takes no rotation: the angle of a stroke is its shape, and what a mark's shape means is a reading of it rather than a property of it."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .


#################################################################
# Properties of edits
#################################################################

reo:added
    a owl:ObjectProperty ;
    rdfs:domain reo:Edit ;
    rdfs:range crm:E90_Symbolic_Object ;
    rdfs:label "added"@en ;
    rdfs:comment """This property associates an edit with a symbol it adds to the version being created: a perforation, or a text written onto the roll."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:removed
    a owl:ObjectProperty ;
    rdfs:domain reo:Edit ;
    rdfs:range crm:E90_Symbolic_Object ;
    rdfs:label "removed"@en ;
    rdfs:comment """This property associates an edit with a symbol of the version it is based on that is absent from the version being created."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .


#################################################################
# Properties of copies
#################################################################

reo:capture
    a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P16i_was_used_for ;
    rdfs:domain lrmoo:F5_Item ;
    rdfs:range crm:E7_Activity ;
    rdfs:label "capture"@en ;
    rdfs:comment """This property associates a copy of a roll with the activity by which its features became the data of an edition. What the features were read from is given by P2 has type with one of the types roll, scan, analysis, reading, emulation and recording at https://w3id.org/reo/type/, the file the activity produced by L11 had output, the machine it ran on by L12 happened on device, the software it ran by L23 used software or firmware, and the instrument a recorded copy was played on by P16 used specific object. Where the activity is a digitisation it is also an instance of D2 Digitization Process, and where it derives one file from another, of D3 Formal Derivation; neither covers all six kinds, so the range is left at E7 Activity and the kind is stated as a type. This property concerns the provenance of the data and not the state of the paper, which is a condition of the copy (P44 has condition). What is not known about the capture is left unstated."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .


#################################################################
# Shortcuts
#
# Each of these stands for a path through CRM and LRMoo that the
# JSON-LD serialisation does not spell out.
#################################################################

reo:involvedEdit
    a owl:ObjectProperty ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:range reo:Edit ;
    rdfs:label "involved edit"@en ;
    rdfs:comment """This property associates a version of a roll with an edit by which it was made from the version it is based on. It is a shortcut of the path R17i was created by, F28 Expression Creation, P9 consists of."""@en ;
    owl:propertyChainAxiom ( lrmoo:R17i_was_created_by crm:P9_consists_of ) ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:witness
    a owl:ObjectProperty ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:range lrmoo:F5_Item ;
    rdfs:label "witness"@en ;
    rdfs:comment """This property associates a digital edition with a physical copy of the roll on which it is based. It is a shortcut of the path R17i was created by, F28 Expression Creation, P16 used specific object."""@en ;
    owl:propertyChainAxiom ( lrmoo:R17i_was_created_by crm:P16_used_specific_object ) ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:siglum
    a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( lrmoo:F2_Expression lrmoo:F5_Item ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "siglum"@en ;
    rdfs:comment """This property states the short label by which an edition refers to a version of the roll, such as A, B1 or B2, or to a copy of it, such as W1. It is a shortcut of the path P1 is identified by, E42 Identifier typed 'siglum', P190 has symbolic content."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .


#################################################################
# Dimensions
#
# Intervals and measured quantities of the format, as
# specialisations of P43 has dimension, P40 observed dimension
# and P90 has value.
#################################################################

reo:from
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P90_has_value ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range xsd:decimal ;
    rdfs:label "from"@en ;
    rdfs:comment """This property states the lower bound of a dimension that is an interval, as the extent of a hole along the roll (in millimetres from its beginning) or across it (in tracks of the tracker bar), or the speed at the beginning of a roll. The unit is given by P91 has unit."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:to
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P90_has_value ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range xsd:decimal ;
    rdfs:label "to"@en ;
    rdfs:comment """This property states the upper bound of a dimension that is an interval. A hole that occupies a single track has no upper bound across the roll."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:tempo
    a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:range crm:E54_Dimension ;
    rdfs:label "tempo"@en ;
    rdfs:comment """This property associates an edition with the speed at which it lets the roll run. Since the take-up spool accelerates as paper winds onto it, the speed is an interval from the beginning of the roll (from) to its end (to), in the unit given by P91 has unit, as feet or metres per minute."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:paperSpeed
    a owl:ObjectProperty ;
    rdfs:domain lrmoo:F32_Item_Production_Event ;
    rdfs:range crm:E54_Dimension ;
    rdfs:label "paper speed"@en ;
    rdfs:comment """This property associates the production of a copy with the paper speed the copy was cut for, as its label, its catalogue or its format states it: a value (P90 has value) in the unit given by P91 has unit, as feet or metres per minute. Rolls for the Green Welte and the Licensee were cut from the Welte-Mignon masters for slower paper speeds (Phillips 2016, pp. 121 and 123), so such a copy comes out shorter than the red roll of the same recording by the ratio of the speeds. An alignment of the two measures that ratio; this property states its cause, which lies in the production and not in the condition of the paper. CIDOC CRM gives an activity no dimension of its own, hence a property of this ontology."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:dimensions
    a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P40_observed_dimension ;
    rdfs:domain crm:E16_Measurement ;
    rdfs:range crm:E54_Dimension ;
    rdfs:label "dimensions"@en ;
    rdfs:comment """This property associates the measurement of a copy with its measured extent: the width across the roll (width) and the length along it (height), in the unit given by P91 has unit."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:width
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P90_has_value ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range xsd:decimal ;
    rdfs:label "width"@en ;
    rdfs:comment "This property states the extent of a copy across the roll."@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:height
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P90_has_value ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range xsd:decimal ;
    rdfs:label "height"@en ;
    rdfs:comment "This property states the extent of a copy along the roll, from its beginning to its end."@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:punchDiameter
    a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P40_observed_dimension ;
    rdfs:domain crm:E16_Measurement ;
    rdfs:range crm:E54_Dimension ;
    rdfs:label "punch diameter"@en ;
    rdfs:comment """This property associates the measurement of a copy with the mean diameter of its punched holes, stated with P90 has value and P91 has unit."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:holeSeparation
    a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P40_observed_dimension ;
    rdfs:domain crm:E16_Measurement ;
    rdfs:range crm:E54_Dimension ;
    rdfs:label "hole separation"@en ;
    rdfs:comment """This property associates the measurement of a copy with the distance between adjacent tracks as found on it, stated with P90 has value and P91 has unit."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .

reo:scanResolution
    a owl:ObjectProperty ;
    rdfs:domain crm:E16_Measurement ;
    rdfs:range crm:E54_Dimension ;
    rdfs:label "scan resolution"@en ;
    rdfs:comment """This property associates the measurement of a copy with the resolution along the roll at which the scan it was taken from was read, stated with P90 has value and P91 has unit. It is what the measurements given in pixels are to be read against. The resolution is a property of the scan and not a dimension observed on the roll, which is why it is no subproperty of P40 observed dimension. A scanner may read across the roll at another resolution."""@en ;
    rdfs:isDefinedBy <https://w3id.org/reo/> .
